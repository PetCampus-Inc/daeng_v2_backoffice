{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "always",
  "bracketSpacing": true,
  "quoteProps": "as-needed",
  "sortPackageJson": false,
  "ignorePatterns": ["pnpm-lock.yaml"]
}
