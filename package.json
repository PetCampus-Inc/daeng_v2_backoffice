{
  "name": "daeng-v2-backoffice",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "infisical run --env=dev turbo run dev",
    "dev:server": "infisical run --env=dev -- turbo run dev --filter=@daeng/server",
    "db:generate": "infisical run --env=dev -- pnpm --filter @daeng/server db:generate",
    "db:migrate": "infisical run --env=dev -- pnpm --filter @daeng/server db:migrate",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm api:lint",
    "api:lint": "redocly lint --extends minimal packages/api-spec/openapi.yaml",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@redocly/cli": "2.70.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "turbo": "^2.11.9"
  }
}
