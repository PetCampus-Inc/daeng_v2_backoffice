# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 git에 올라가지 않는다.

# Google Identity Services의 OAuth 클라이언트 ID. 배포 build에서 구글 로그인 버튼을 띄울 때 쓴다.
# 개발 서버(가짜 API)에서는 개발용 계정 고르기를 쓰므로 비워 둬도 된다.
VITE_GOOGLE_CLIENT_ID=

# 관리자 API 주소. 예: https://bo.knockdog.net/api/v0/admin
# 비워 두면 화면이 열린 주소와 같은 곳(/api/v0/admin)으로 요청한다. 개발 서버(가짜 API)에서는 비워 둔다.
# 값을 넣으면 서버가 이 화면 주소를 ALLOWED_ORIGINS(CORS)에 허용하고, 쿠키를 다른 사이트로 보낼 수 있게 설정해야 한다.
VITE_API_BASE_URL=

# Sentry 프로젝트의 DSN. 배포 build에서 에러를 보낼 때 쓴다. 비워 두면 Sentry를 켜지 않는다.
# 소스맵 업로드용 SENTRY_AUTH_TOKEN·SENTRY_ORG·SENTRY_PROJECT는 이 파일이 아니라 배포(CI) 환경 변수로만 둔다.
VITE_SENTRY_DSN=
