# --- 선택: 비우거나 지우면 기본값을 쓴다 ---
# PORT=3000
# API_DOCS_ENABLED=true

# --- 필수: BO 전용 DB. 계정 이름과 비밀번호는 Infisical에서 받는다 ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- 필수: 로그인 ---
# 구글 OAuth 웹 클라이언트 ID(...apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# 쓰기 요청을 허용할 웹 주소. 쉼표로 구분하고 경로·끝 슬래시 없이 적는다
ALLOWED_ORIGINS=

# --- 선택 ---
# 첫 실행 때 최고 관리자로 등록할 구글 이메일
# INITIAL_SUPER_ADMIN_EMAIL=
# 쿠키 Secure. 기본은 true이고 HTTPS가 아닌 로컬에서는 false로 둔다
# COOKIE_SECURE=false
# 개발용 로그인(구글 없이 이메일로 로그인). 로컬에서만 true, COOKIE_SECURE=false일 때만 켤 수 있다
# DEV_LOGIN_ENABLED=true
