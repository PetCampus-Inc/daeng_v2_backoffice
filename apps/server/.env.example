# --- 선택: 비우거나 지우면 기본값을 쓴다 ---
# PORT=3000
# API_DOCS_ENABLED=true

# --- 필수: BO 전용 DB. 계정 이름과 비밀번호는 Infisical에서 받는다 ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- 필수: 서비스(Java) DB. 문의 등 서비스 데이터를 읽기 전용 계정으로 조회한다. 계정은 Infisical에서 받는다 ---
SERVICE_DB_HOST=
SERVICE_DB_PORT=
SERVICE_DB_NAME=
SERVICE_DB_USER=
SERVICE_DB_PASSWORD=

# --- 필수: Java 서버 호출(문의·공지·약관). 키는 Java의 BACKOFFICE_INTERNAL_API_KEY와 같은 값이다 ---
JAVA_API_BASE_URL=
JAVA_API_KEY=
# 문의 이미지 주소의 앞부분(뒤에 S3 키를 붙인다). 끝 슬래시 없이 적는다
INQUIRY_IMAGE_BASE_URL=

# --- 필수: 로그인 ---
# 구글 OAuth 웹 클라이언트 ID(...apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# 쓰기 요청을 허용할 웹 주소. 쉼표로 구분하고 경로·끝 슬래시 없이 적는다
ALLOWED_ORIGINS=

# --- 선택 ---
# 첫 실행 때 최고 관리자로 등록할 구글 이메일
# INITIAL_SUPER_ADMIN_EMAIL=
# 쿠키 Secure. 기본은 true이고 HTTPS가 아닌 로컬에서는 false로 둔다
# COOKIE_SECURE=false
# 개발용 로그인(구글 없이 이메일로 로그인). 로컬에서만 true, COOKIE_SECURE=false일 때만 켤 수 있다
# DEV_LOGIN_ENABLED=true
